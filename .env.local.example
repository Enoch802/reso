# Optional — AI features (timetable reading, journal, digest, coach, email ranking)
OPENROUTER_API_KEY=

# Optional — Gmail connect (read-only) in Settings > Email
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional — server-side Gmail authorization-code exchange and token refresh
GOOGLE_CLIENT_SECRET=

# Optional — fixed deployed callback URL (defaults to <origin>/api/email/callback)
GOOGLE_REDIRECT_URI=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# No DATABASE_URL is needed: Reso has no server-side database.
